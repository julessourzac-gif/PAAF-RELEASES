#!/bin/bash
# Lanceur de PAAF. Tout est embarqué dans l'application : Python (avec tkinter), les
# bibliothèques et ffmpeg / ffprobe (Contents/Resources/python et Contents/Resources/bin).
# Rien à installer, pas besoin de Homebrew ni d'Internet.

APP_VERSION="@VERSION@"
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
SUPPORT="$HOME/Library/Application Support/PAAF"
OLD_SUPPORT="$HOME/Library/Application Support/Import Pro Tools"
LOG="$SUPPORT/paaf.log"
PY="$RES/python/bin/python3"

# ffmpeg / ffprobe embarqués d'abord ; PATH réduit au système (pas de Homebrew)
export PATH="$RES/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# Python isolé : pas de site utilisateur ni de variables héritées, pas d'écriture de .pyc
# dans l'application (elle est signée ; les .pyc sont précompilés au build)
unset PYTHONHOME PYTHONPATH PYTHONSTARTUP
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1

# Ancien nom de l'application (Import Pro Tools) : on reprend son dossier (journal, réglages)
if [ ! -d "$SUPPORT" ] && [ -d "$OLD_SUPPORT" ]; then
  mv "$OLD_SUPPORT" "$SUPPORT" 2>/dev/null
fi
mkdir -p "$SUPPORT"
# journal limité aux ~2000 dernières lignes
[ -f "$LOG" ] && tail -n 2000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
exec >>"$LOG" 2>&1
echo "=== $(date '+%Y-%m-%d %H:%M:%S') — PAAF v$APP_VERSION ($(uname -m))"

fail() {
  echo "ERREUR : $1"
  osascript - "$1

Journal : $LOG" <<'OSA' >/dev/null 2>&1
on run argv
  display alert "PAAF" message (item 1 of argv) as critical
end run
OSA
  exit 1
}

[ -x "$PY" ] || fail "L'application est incomplète (Python embarqué introuvable). Réinstalle PAAF."
echo "Python : $("$PY" --version 2>&1) · $(ffmpeg -hide_banner -version 2>/dev/null | head -1)"
"$PY" -c "import tkinter, ptsl" || fail "Les bibliothèques embarquées ne se chargent pas."
cd "$RES"
exec "$PY" "$RES/ptsl_import_gui.py"
